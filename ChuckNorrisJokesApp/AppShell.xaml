<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ChuckNorrisJokesApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ChuckNorrisJokesApp.Views"
    Title="ChuckNorrisJokesApp">

    <TabBar>
        <ShellContent
    Title="Chuck Norris"
    ContentTemplate="{DataTemplate views:JokesView}"
    Route="JokesView" />

    <ShellContent
    Title="Dad Jokes"
    ContentTemplate="{DataTemplate views:DadJokesView}"
    Route="DadJokesView" />
    </TabBar>

</Shell>
